MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?appName=guidexpert
PORT=5000
KARIX_ACCESS_KEY=
KARIX_SENDER_ID=
# QueryString receiver: the only Karix endpoint that delivers on this account.
# The JSON receivers accept the request and then silently drop the message.
KARIX_QS_URL=https://japi.instaalerts.zone/httpapi/QueryStringReceiver
# Must match the approved DLT template exactly. Keep the double quotes: an unquoted
# # character starts a comment and would silently truncate the message.
KARIX_OTP_TEXT="Your OTP for registering with NIAT Guru Ratna Awards 2026 is {#var#}. Valid for 5 minutes. Do not share this code with anyone."
KARIX_OTP_EXPIRY=5
KARIX_DLT_TEMPLATE_ID=
KARIX_DLT_ENTITY_ID=
KARIX_DLT_TM_ID=
# Shared token for the delivery report callback Karix provisions on the account:
# https://<backend-host>/api/otp/dlr?token=<KARIX_DLR_TOKEN>
# Leave empty to accept unauthenticated reports.
KARIX_DLR_TOKEN=
# Local testing only: prints the OTP to the server console. Ignored when NODE_ENV=production.
OTP_DEV_CONSOLE=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SECRET=
CORS_ORIGINS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
