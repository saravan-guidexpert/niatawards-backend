MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?appName=guidexpert
PORT=5000

# MSG91 delivers the OTP SMS only. This backend generates and verifies the code.
MSG91_AUTH_KEY=
# MSG91 dashboard → OTP → Templates (24-char id). Must contain ##OTP##. Not the TRAI DLT number.
MSG91_TEMPLATE_ID=
# HMAC key for hashing OTPs. Generate with: openssl rand -hex 32
OTP_SECRET=
# How long the code lives. Defaults to 10 if unset.
OTP_EXPIRY_MINUTES=5
# QA only: comma-separated 10-digit numbers that skip SMS.
OTP_BYPASS_PHONES=
OTP_BYPASS_CODE=123456
# Local testing only: prints the OTP to the server console. Ignored when NODE_ENV=production.
OTP_DEV_CONSOLE=

ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SECRET=
CORS_ORIGINS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp (Gupshup). Leave ENABLE_WHATSAPP=false until you want real sends.
# Template IDs are looked up as GUPSHUP_TEMPLATE_<KIND> (e.g. GUPSHUP_TEMPLATE_WELCOME).
ENABLE_WHATSAPP=false
# App API key from Gupshup → App → Settings (used as the `apikey` header on api.gupshup.io).
# Do not use a Partner app token here (those start with sk_) — that returns 403 Unauthorised Access.
GUPSHUP_API_KEY=
# Sender number, digits only (91XXXXXXXXXX).
GUPSHUP_SOURCE=
# Gupshup app name (src.name) — exact "App name" from the dashboard Templates/Settings header.
GUPSHUP_SRC_NAME=
# Shared secret for POST /webhook/gupshup. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set this on the server AND in the Gupshup callback URL (?secret=...) in the same change,
# or inbound silently 401s. Leave empty until both sides are ready.
GUPSHUP_WEBHOOK_SECRET=
# Optional: GUPSHUP_WEBHOOK_AUTH_REQUIRED=0 never enforces; =1 always enforces.
# GUPSHUP_TEMPLATE_TEST=
# GUPSHUP_TEMPLATE_WELCOME=
# Teacher self-nomination confirmation. {{1}} is the teacher name; image header is in code.
GUPSHUP_TEMPLATE_TEACHER_SUBMIT=
